{
  "name": "foto",
  "version": "1.0.0",
  "private": true,
  "description": "Foto \u2014 event photo sharing that combines the QR-code guest camera of Fotify, GuestPix and Kululu with the disposable film-roll camera of GuestCam: the app, the API it calls, and the AWS stacks that deploy it.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace foto-web",
    "build": "npm run build --workspace foto-web",
    "start": "npm run start --workspace foto-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "synth": "npm run synth --workspace foto-infra",
    "diff": "npm run diff --workspace foto-infra",
    "deploy": "npm run deploy --workspace foto-infra",
    "deploy:full": "npm run deploy:full --workspace foto-infra"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "concurrently": "^9.1.0",
    "typescript": "^5.5.4"
  }
}

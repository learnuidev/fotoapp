{
  "name": "foto-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK app for the Foto backend — the API, the photos bucket, the tables behind it, and the user pool the host console signs in to.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "bootstrap": "cdk bootstrap",
    "destroy": "cdk destroy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "aws-cdk": "^2.160.0",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

# What the foto console writes into this file when it points the app at a stage.
# Nothing here is secret: every value is a published stack output or parameter.
#
# Copy it to `.env.local` to run the app by hand — or press Start on the console's
# Frontend page and let it write the real values for a stage.

# FotoApiStack-<stage> output ApiUrl
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# /foto/<stage>/cognito/user-pool-id and /foto/<stage>/cognito/client-id (SSM)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Where this app is served — the origin a printed QR code points at.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Optional: the join code of an event the front page offers as "walk into a wedding
# we seeded". Unset, the front page simply does not offer one.
# NEXT_PUBLIC_DEMO_CODE=XXXXXX

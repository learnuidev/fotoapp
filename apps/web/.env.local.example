# Copy to `.env.local` and restart `npm run dev`.
#
# Where the API is. `npm run dev` starts it on 4100; a deployed stage puts its own
# URL here.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Where this app is served, which is what a QR code in a `npm run seed` event
# points at. The API uses it to build links in the console.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Host sign-in against Cognito (optional) ----------------------------------
# Leave these unset to sign hosts in against the API's own account store, which is
# what `npm run seed` makes. With a user pool configured, the console signs in
# through Amplify instead — see packages/auth/src/lib/driver.ts.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
